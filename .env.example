# Vercel: ключ Gemini API (тип Secret).
GEMINI_API_KEY=your_gemini_api_key_here

# Локально, необязательно: путь к JSON-ключу Service Account внутри secrets/.
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=secrets/service-account.json

# Локально, необязательно: порт сервера (по умолчанию 8080).
# PORT=8080

# ID папки Google Drive вводится в настройках сайта, в .env не используется.
# Текущая интеграция Google Drive ещё не поддерживает работу на Vercel.
